# ==============================================================================
# API Keys for Social Media Caption Generator
# Fill in the key for the provider you want to use.
# ==============================================================================

# Google Gemini API (Default provider)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API
# Get a key from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=

# Anthropic Claude API
# Get a key from Anthropic Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=
